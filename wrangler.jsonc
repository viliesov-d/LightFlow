{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lightflow-api",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "SCHEDULES",
      "id": "d3ee8d43684946689a4067a3afda06d9"
    }
  ]
}
