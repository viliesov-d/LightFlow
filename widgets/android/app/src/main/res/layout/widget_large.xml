        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text="—"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#B9C9DB"
        android:textSize="10sp"/>
    <TextView
        android:id="@+id/period6"
