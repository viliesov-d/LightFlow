        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Червоний — немає світла · Зелений — є за графіком"
        android:textColor="#8FA3BC"
        android:textSize="9sp"
        android:maxLines="2"/>
</LinearLayout>
