<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/largeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚡ LightFlow · Черкаська 1.1"
        android:textColor="#F9FBFF"
        android:textStyle="bold"
        android:textSize="15sp"/>
    <TextView
        android:id="@+id/largeStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Перевіряємо…"
        android:textColor="#F9FBFF"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="7dp"/>
    <TextView
        android:id="@+id/largeInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Графік на сьогодні"
        android:textColor="#B9C9DB"
        android:textSize="10sp"
        android:layout_marginTop="3dp"/>
    <Space android:layout_width="1dp" android:layout_height="8dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">
    <TextView
        android:id="@+id/period1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text="—"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#B9C9DB"
        android:textSize="10sp"/>
    <TextView
        android:id="@+id/period2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text="—"
        android:ellipsize="end"
