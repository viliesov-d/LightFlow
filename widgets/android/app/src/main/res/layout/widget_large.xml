<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/largeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <ImageView
        android:id="@+id/largeArtwork"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <FrameLayout
        android:id="@+id/largeLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0121C2B"
        android:visibility="gone">

        <ImageView
            android:id="@+id/largeRipple"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/ripple_stage_1"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/largeLoadingText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="13dp"
            android:gravity="center"
            android:text="Оновлюємо…"
            android:textColor="#F4F8FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </FrameLayout>
</FrameLayout>
