<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compactRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
>

    <ImageView
        android:id="@+id/compactArtwork"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <FrameLayout
        android:id="@+id/compactLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:visibility="gone">

        <ImageView
            android:id="@+id/compactRipple"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/ripple_stage_1"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/compactLoadingText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="13dp"
            android:gravity="center"
            android:text="Оновлюємо…"
            android:textColor="#F4F8FF"
            android:shadowColor="#D9000A16"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </FrameLayout>
</FrameLayout>
